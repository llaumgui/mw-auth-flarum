{
	"name": "llaumgui/mw-auth-flarum",
	"type": "mediawiki-extension",
	"description": "Allow to connect on MediaWiki from Flarum account.",
	"keywords": [
		"wiki",
		"MediaWiki",
		"extension",
		"Flarum"
	],
	"homepage": "https://github.com/llaumgui/mw-auth-flarum",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Guillaume Kulakowski"
		}
	],
	"support": {
		"source": "https://github.com/llaumgui/mw-auth-flarum"
	},
	"require": {
		"php": ">=8.4"
	},
	"require-dev": {
		"guzzlehttp/guzzle": "^7.4",
		"mediawiki/mediawiki-codesniffer": "52.0.2",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"AuthFlarum\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AuthFlarum\\Tests\\": "tests/phpunit/unit/"
		}
	},
	"scripts": {
		"test": [
			"vendor/bin/parallel-lint . --exclude node_modules --exclude vendor",
			"vendor/bin/phpcs -p -s",
			"vendor/bin/minus-x check .",
			"@phpunit"
		],
		"phpunit": "XDEBUG_MODE=coverage phpunit -c phpunit.xml.dist",
		"fix": [
			"vendor/bin/minus-x fix .",
			"vendor/bin/phpcbf"
		],
		"phan": "vendor/bin/phan -d . --long-progress-bar"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
